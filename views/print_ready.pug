doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Birth Certificate - Print
    style.
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Times New Roman', serif; padding: 40px; background: white; color: #1a1a1a; }
      .certificate { max-width: 800px; margin: 0 auto; border: 3px double #166534; padding: 40px; }
      .header { text-align: center; border-bottom: 2px solid #166534; padding-bottom: 20px; margin-bottom: 20px; }
      .header h1 { font-size: 24px; font-weight: bold; margin-bottom: 5px; }
      .header h2 { font-size: 20px; color: #166534; margin-top: 15px; }
      .header p { font-size: 12px; color: #666; }
      .seals { display: flex; justify-content: center; gap: 20px; margin-bottom: 15px; }
      .seals img { width: 60px; height: 60px; }
      .section { margin-bottom: 25px; }
      .section-title { font-size: 14px; font-weight: bold; color: #166534; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 5px; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
      .field { margin-bottom: 10px; }
      .field-label { font-size: 10px; color: #666; text-transform: uppercase; margin-bottom: 3px; }
      .field-value { font-size: 14px; font-weight: 500; }
      .footer { border-top: 2px solid #166534; padding-top: 20px; margin-top: 30px; display: flex; justify-content: space-between; }
      .signature { text-align: right; }
      .signature-line { border-top: 1px solid #333; width: 200px; margin-top: 50px; padding-top: 5px; }
      @media print { body { padding: 0; } .certificate { border: none; } }

  body
    .certificate
      .header
        .seals
          img(src="/images/stamp1.png" alt="Seal")
          img(src="/images/stamp2.png" alt="Seal")
        h1 REPUBLIC OF CAMEROON
        p Peace - Work - Fatherland
        h2 BIRTH CERTIFICATE
        if birth && birth.certificateNumber
          p Certificate No: #{birth.certificateNumber}

      if birth
        .section
          .section-title Child Information
          .grid
            .field
              .field-label Full Name
              .field-value= birth.givenname + ' ' + birth.surname
            .field
              .field-label Date of Birth
              .field-value= birth.bornOn ? new Date(birth.bornOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .field
              .field-label Place of Birth
              .field-value= birth.bornAt
            .field
              .field-label Sex
              .field-value= birth.sex

        .section
          .section-title Father's Information
          .grid
            .field
              .field-label Full Name
              .field-value= birth.fatherName
            .field
              .field-label Date of Birth
              .field-value= birth.fatherBornOn ? new Date(birth.fatherBornOn).toLocaleDateString() : '-'
            .field
              .field-label Place of Birth
              .field-value= birth.fatherBornAt
            .field
              .field-label Residence
              .field-value= birth.fatherResidentAt
            .field
              .field-label Occupation
              .field-value= birth.fatherOccupation
            .field
              .field-label Nationality
              .field-value= birth.fatherNationality
            .field
              .field-label National ID
              .field-value= birth.fatherRefDoc

        .section
          .section-title Mother's Information
          .grid
            .field
              .field-label Full Name
              .field-value= birth.motherName
            .field
              .field-label Date of Birth
              .field-value= birth.motherBornOn ? new Date(birth.motherBornOn).toLocaleDateString() : '-'
            .field
              .field-label Place of Birth
              .field-value= birth.motherBornAt
            .field
              .field-label Residence
              .field-value= birth.motherResidentAt
            .field
              .field-label Occupation
              .field-value= birth.motherOccupation || 'N/A'
            .field
              .field-label Nationality
              .field-value= birth.motherNationality
            .field
              .field-label National ID
              .field-value= birth.motherRefDoc

        .footer
          .field
            .field-label Drawn Up On
            .field-value= birth.drawnUpOn ? new Date(birth.drawnUpOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
          .signature
            .signature-line Civil Registry Officer
