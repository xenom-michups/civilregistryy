doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Error | Civil Registry System
    link(rel="stylesheet" href="/styles/tailwind.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="icon" href="/images/Favicon.png" type="image/png")

  body.bg-dark-950.text-white.min-h-screen.flex.items-center.justify-center
    .text-center.px-6
      //- Error Icon
      div(class="w-24 h-24 bg-red-600/20 rounded-full flex items-center justify-center mx-auto mb-8")
        svg.w-12.h-12.text-red-500(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")

      h1.text-4xl.font-bold.mb-4 Oops! Something went wrong
      p.text-xl.text-dark-400.mb-2= message || 'An unexpected error occurred'
      if error && error.status
        p.text-dark-500.mb-8 Error Code: #{error.status}

      .flex.items-center.justify-center.gap-4
        a.btn.btn-primary(href="/")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6")
          span Go Home
        a.btn.btn-secondary(href="javascript:history.back()")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
          span Go Back

      //- Stack trace in development
      if error && error.stack
        .mt-12.text-left.max-w-2xl.mx-auto
          details.card.p-4
            summary.cursor-pointer.text-sm.font-medium.text-dark-400 View Error Details
            pre.mt-4.text-xs.text-dark-500.overflow-x-auto.p-4.bg-dark-900.rounded-lg= error.stack
