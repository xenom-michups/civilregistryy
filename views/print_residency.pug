doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Residency Certificate - Print
    style.
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Times New Roman', serif; padding: 40px; background: white; color: #1a1a1a; }
      .certificate { max-width: 800px; margin: 0 auto; border: 3px double #166534; padding: 40px; }
      .header { text-align: center; border-bottom: 2px solid #166534; padding-bottom: 20px; margin-bottom: 30px; }
      .header h1 { font-size: 24px; font-weight: bold; margin-bottom: 5px; }
      .header h2 { font-size: 20px; color: #166534; margin-top: 15px; }
      .header p { font-size: 12px; color: #666; }
      .seals { display: flex; justify-content: center; gap: 20px; margin-bottom: 15px; }
      .seals img { width: 60px; height: 60px; }
      .body-text { font-size: 16px; line-height: 1.8; text-align: justify; margin-bottom: 20px; }
      .body-text strong { font-weight: bold; }
      .person-box { background: #f0fdf4; border: 2px solid #166534; padding: 20px; text-align: center; margin: 20px 0; }
      .person-name { font-size: 22px; font-weight: bold; color: #166534; margin-bottom: 10px; }
      .person-details { font-size: 14px; color: #333; }
      .address-box { background: #f9fafb; padding: 15px; margin: 20px 0; }
      .address-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
      .field { margin-bottom: 10px; }
      .field-label { font-size: 10px; color: #666; text-transform: uppercase; margin-bottom: 3px; }
      .field-value { font-size: 14px; font-weight: 500; }
      .validity { background: #fef3c7; border: 1px solid #f59e0b; padding: 15px; text-align: center; margin: 20px 0; font-size: 14px; }
      .signatures { border-top: 2px solid #166534; padding-top: 30px; margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
      .signature-block { }
      .signature-block.right { text-align: right; }
      .signature-line { border-top: 1px solid #333; margin-top: 80px; padding-top: 5px; }
      .signature-label { font-size: 10px; color: #666; text-transform: uppercase; }
      .footer-note { margin-top: 30px; padding: 15px; background: #f3f4f6; font-size: 11px; color: #666; text-align: center; }
      @media print { body { padding: 0; } .certificate { border: none; } }

  body
    .certificate
      .header
        .seals
          img(src="/images/stamp1.png" alt="Seal")
          img(src="/images/stamp2.png" alt="Seal")
        h1 REPUBLIC OF CAMEROON
        p Peace - Work - Fatherland
        h2 CERTIFICATE OF RESIDENCY
        if residency && residency.certificateNumber
          p Certificate No: #{residency.certificateNumber}

      if residency
        .body-text
          | The undersigned, Mayor of 
          strong= residency.residenceMunicipality
          | , hereby certifies that:

        .person-box
          .person-name= residency.applicantGivenname + ' ' + residency.applicantSurname
          .person-details
            | Born on #{residency.applicantBornOn ? new Date(residency.applicantBornOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'} at #{residency.applicantBornAt}
            br
            | Nationality: #{residency.applicantNationality} | National ID: #{residency.applicantIdNum}

        .body-text(style="text-align: center;")
          | Is a bona fide resident of:

        .address-box
          .address-grid
            .field
              .field-label Address
              .field-value= residency.residenceAddress
            .field
              .field-label Quarter/Neighborhood
              .field-value= residency.residenceQuarter
            .field
              .field-label Municipality
              .field-value= residency.residenceMunicipality
            .field
              .field-label Resident Since
              .field-value= residency.residenceSince ? new Date(residency.residenceSince).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'

        .body-text(style="text-align: center;")
          | This certificate is issued for the purpose of: 
          strong= residency.purpose

        .validity
          | This certificate is valid for 
          strong three (3) months 
          | from the date of issue.
          if residency.validUntil
            br
            | Valid until: 
            strong= new Date(residency.validUntil).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

        .signatures
          .signature-block
            .field
              .field-label Issued On
              .field-value= residency.issuedOn ? new Date(residency.issuedOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .field
              .field-label At
              .field-value= residency.residenceMunicipality
          .signature-block.right
            .signature-label Mayor's Signature & Official Seal
            .signature-line
              strong The Mayor
              br
              | #{residency.residenceMunicipality} Municipality

        .footer-note
          | This certificate is issued in accordance with the laws of the Republic of Cameroon.
          br
          | Any falsification of this document is punishable by law.
