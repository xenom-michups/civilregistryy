doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title + ' | Civil Registry System'
    link(rel="stylesheet" href="/styles/tailwind.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="icon" href="/images/Favicon.png" type="image/png")
    link(rel="stylesheet" href="/styles/print.css" media="print")
    script(src="https://cdn.jsdelivr.net/npm/apexcharts")

  body.bg-dark-950.text-white.min-h-screen
    .flex.min-h-screen
      //- Sidebar
      aside.fixed.inset-y-0.left-0.z-50.w-64.bg-dark-900.border-r.border-dark-800.transform.transition-transform.duration-300.ease-in-out(class="lg:translate-x-0" id="sidebar")
        .flex.flex-col.h-full
          //- Logo
          .flex.items-center.gap-3.px-6.py-5.border-b.border-dark-800
            .w-10.h-10.bg-primary-600.rounded-xl.flex.items-center.justify-center
              svg.w-6.h-6.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
            .flex.flex-col
              span.text-lg.font-bold.text-white CRS
              span.text-xs.text-dark-400 Civil Registry

          //- User Profile
          if user
            .px-6.py-4.border-b.border-dark-800
              .flex.items-center.gap-3
                img.w-12.h-12.rounded-full.object-cover.ring-2.ring-primary-500(src=`/images/${user.photo || 'profile.jpeg'}` alt="Profile")
                .flex.flex-col
                  span.text-sm.font-semibold.text-white= user.name
                  span.text-xs.text-primary-500.capitalize= user.role

          //- Navigation
          nav.flex-1.px-4.py-6.space-y-2.overflow-y-auto
            if user && user.role === 'admin'
              a.sidebar-link(href="/admin" class=title === 'Admin Dashboard' ? 'active' : '')
                svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z")
                span Admin Panel
            else
              a.sidebar-link(href="/dashboard" class=title === 'Dashboard' ? 'active' : '')
                svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6")
                span Dashboard

            .pt-4.pb-2
              span.px-4.text-xs.font-semibold.text-dark-500.uppercase.tracking-wider Certificates

            a.sidebar-link(href="/birth" class=title === 'Register Birth' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z")
              span Birth Certificate

            a.sidebar-link(href="/death" class=title === 'Register Death' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z")
              span Death Certificate

            a.sidebar-link(href="/marriage" class=title === 'Register Marriage' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
              span Marriage Certificate

            a.sidebar-link(href="/residency" class=title === 'Residency Certificate' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6")
              span Residency Certificate

            .pt-4.pb-2
              span.px-4.text-xs.font-semibold.text-dark-500.uppercase.tracking-wider Management

            a.sidebar-link(href="/requests" class=title === 'Certificate Requests' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
              span Online Requests

            .pt-4.pb-2
              span.px-4.text-xs.font-semibold.text-dark-500.uppercase.tracking-wider Tools

            a.sidebar-link(href="/upload" class=title === 'Upload CSV' ? 'active' : '')
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12")
              span Upload CSV

          //- Logout
          .px-4.py-4.border-t.border-dark-800
            button#logoutBtn.sidebar-link.w-full.text-red-400(class="hover:text-red-300 hover:bg-red-500/10")
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1")
              span Logout

      //- Main Content
      main.flex-1.ml-64
        //- Top Header
        header.sticky.top-0.z-40.glass.border-b.border-dark-800
          .flex.items-center.justify-between.px-8.py-4
            .flex.items-center.gap-4
              button#sidebarToggle.p-2.rounded-lg.text-dark-400(class="lg:hidden hover:bg-dark-800")
                svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16")
              h1.text-xl.font-semibold.text-white= title

            .flex.items-center.gap-4
              //- Search
              .relative.hidden(class="md:block")
                input.input.w-64.pl-10(type="search" placeholder="Search...")
                svg(class="w-5 h-5 text-dark-400 absolute left-3 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")

              //- Notifications
              button.relative.p-2.rounded-lg.text-dark-400.transition-colors(class="hover:bg-dark-800 hover:text-white")
                svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9")
                span.absolute.top-1.right-1.w-2.h-2.bg-red-500.rounded-full

        //- Page Content
        .p-8
          block content

    script(src="/js/animation.js")
    script(src="/js/login.js")
    script(src="/js/typeahead.js")
    script.
      async function downloadPDF(type) {
        try {
          const btn = event.target.closest('button');
          const originalText = btn.innerHTML;
          btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Generating...';
          btn.disabled = true;
          
          const res = await fetch(`/create-${type}-pdf`);
          const data = await res.json();
          
          if (data.status === 'success') {
            window.location.href = `/${type}-pdf`;
          } else {
            alert('Error generating PDF: ' + data.message);
          }
        } catch (err) {
          alert('Error generating PDF. Please try again.');
        } finally {
          if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
        }
      }
    block scripts
