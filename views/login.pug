doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login | Civil Registry System
    link(rel="stylesheet" href="/styles/tailwind.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="icon" href="/images/Favicon.png" type="image/png")

  body.bg-dark-950.text-white.min-h-screen
    .min-h-screen.flex
      //- Left Side - Branding
      div(class="hidden w-1/2 bg-gradient-to-br from-primary-900 via-dark-900 to-dark-950 relative overflow-hidden lg:flex lg:flex-col lg:justify-center lg:items-center")
        .absolute.inset-0
          div(class="absolute top-20 left-20 w-72 h-72 bg-primary-600 rounded-full filter blur-3xl opacity-20 animate-pulse")
          div(class="absolute bottom-20 right-20 w-96 h-96 bg-primary-400 rounded-full filter blur-3xl opacity-10 animate-pulse")

        .relative.z-10.max-w-lg.px-12.text-center
          div(class="w-20 h-20 bg-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-8 shadow-lg shadow-primary-500/30")
            svg.w-12.h-12.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")

          h1.text-4xl.font-bold.mb-4 Civil Registry System
          p.text-xl.text-dark-300.mb-8 Secure and efficient certificate management for government operations.

          .space-y-4.text-left
            .flex.items-center.gap-4
              div(class="w-10 h-10 bg-primary-600/20 rounded-lg flex items-center justify-center flex-shrink-0")
                svg.w-5.h-5.text-primary-500(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
              span.text-dark-300 Manage birth & death certificates
            .flex.items-center.gap-4
              div(class="w-10 h-10 bg-primary-600/20 rounded-lg flex items-center justify-center flex-shrink-0")
                svg.w-5.h-5.text-primary-500(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
              span.text-dark-300 Manage marriage & residency certificates
            .flex.items-center.gap-4
              div(class="w-10 h-10 bg-primary-600/20 rounded-lg flex items-center justify-center flex-shrink-0")
                svg.w-5.h-5.text-primary-500(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7")
              span.text-dark-300 Process online certificate requests

      //- Right Side - Login/Register Form
      .flex-1.flex.items-center.justify-center.p-8
        .w-full.max-w-md
          div(class="flex items-center justify-center gap-3 mb-8 lg:hidden")
            .w-12.h-12.bg-primary-600.rounded-xl.flex.items-center.justify-center
              svg.w-7.h-7.text-white(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
            span.text-2xl.font-bold CRS

          //- Tab Switcher
          .flex.mb-8.bg-dark-800.rounded-xl.p-1
            button#loginTab.flex-1.py-3.px-4.rounded-lg.text-sm.font-medium.transition-all.bg-primary-600.text-white(type="button") Sign In
            button#registerTab.flex-1.py-3.px-4.rounded-lg.text-sm.font-medium.transition-all.text-dark-400(type="button" class="hover:text-white") Register

          //- Login Form
          #loginSection
            .text-center.mb-8
              h2.text-3xl.font-bold.mb-2 Welcome Back
              p.text-dark-400 Sign in to access your account

            form#loginForm.space-y-6
              div(id="loginError" class="hidden p-4 bg-red-500/20 border border-red-500/50 rounded-lg text-red-400 text-sm")

              div
                label.label(for="loginEmail") Email Address
                .relative
                  input#loginEmail.input.pl-12(type="email" placeholder="Enter your email" required)
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207")

              div
                label.label(for="loginPassword") Password
                .relative
                  input#loginPassword.input.pl-12(type="password" placeholder="Enter your password" required minlength="8")
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")

              .flex.items-center.justify-between
                label.flex.items-center.gap-2.cursor-pointer
                  input.w-4.h-4.rounded.border-dark-600.bg-dark-800.text-primary-600(type="checkbox" class="focus:ring-primary-500")
                  span.text-sm.text-dark-400 Remember me

              button.btn.btn-primary.w-full.py-4.text-base(type="submit")
                span#loginBtnText Sign In
                svg#loginSpinner.hidden.w-5.h-5.ml-2.animate-spin(fill="none" viewBox="0 0 24 24")
                  circle.opacity-25(cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4")
                  path.opacity-75(fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")

          //- Client Register Form
          #registerSection.hidden
            .text-center.mb-8
              h2.text-3xl.font-bold.mb-2 Create Account
              p.text-dark-400 Register to request certificates online

            form#registerForm.space-y-5
              div(id="registerError" class="hidden p-4 bg-red-500/20 border border-red-500/50 rounded-lg text-red-400 text-sm")
              div(id="registerSuccess" class="hidden p-4 bg-green-500/20 border border-green-500/50 rounded-lg text-green-400 text-sm")

              div
                label.label(for="registerName") Full Name
                .relative
                  input#registerName.input.pl-12(type="text" placeholder="Enter your full name" required)
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")

              div
                label.label(for="registerEmail") Email Address
                .relative
                  input#registerEmail.input.pl-12(type="email" placeholder="Enter your email" required)
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207")

              div
                label.label(for="registerPhone") Phone Number
                .relative
                  input#registerPhone.input.pl-12(type="tel" placeholder="Enter your phone number")
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z")

              div
                label.label(for="registerAddress") Address
                .relative
                  input#registerAddress.input.pl-12(type="text" placeholder="Enter your address")
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z")

              div
                label.label(for="registerPassword") Password
                .relative
                  input#registerPassword.input.pl-12(type="password" placeholder="Min 8 characters" required minlength="8")
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")

              div
                label.label(for="registerPasswordConfirm") Confirm Password
                .relative
                  input#registerPasswordConfirm.input.pl-12(type="password" placeholder="Confirm your password" required minlength="8")
                  svg(class="w-5 h-5 text-dark-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")

              button.btn.btn-primary.w-full.py-4.text-base(type="submit")
                span#registerBtnText Create Account
                svg#registerSpinner.hidden.w-5.h-5.ml-2.animate-spin(fill="none" viewBox="0 0 24 24")
                  circle.opacity-25(cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4")
                  path.opacity-75(fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")

          .mt-8.text-center
            a.text-dark-400.text-sm(href="/" class="hover:text-primary-500")
              | ← Back to Home

    script.
      // Tab switching
      const loginTab = document.getElementById('loginTab');
      const registerTab = document.getElementById('registerTab');
      const loginSection = document.getElementById('loginSection');
      const registerSection = document.getElementById('registerSection');

      loginTab.addEventListener('click', () => {
        loginTab.classList.add('bg-primary-600', 'text-white');
        loginTab.classList.remove('text-dark-400');
        registerTab.classList.remove('bg-primary-600', 'text-white');
        registerTab.classList.add('text-dark-400');
        loginSection.classList.remove('hidden');
        registerSection.classList.add('hidden');
      });

      registerTab.addEventListener('click', () => {
        registerTab.classList.add('bg-primary-600', 'text-white');
        registerTab.classList.remove('text-dark-400');
        loginTab.classList.remove('bg-primary-600', 'text-white');
        loginTab.classList.add('text-dark-400');
        registerSection.classList.remove('hidden');
        loginSection.classList.add('hidden');
      });

      // Login form
      document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const errorDiv = document.getElementById('loginError');
        const btnText = document.getElementById('loginBtnText');
        const spinner = document.getElementById('loginSpinner');

        btnText.textContent = 'Signing in...';
        spinner.classList.remove('hidden');
        errorDiv.classList.add('hidden');

        try {
          const res = await fetch('/api/users/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();

          if (data.status === 'success') {
            const role = data.data.user.role;
            if (role === 'client') {
              window.location.href = '/client-dashboard';
            } else if (role === 'admin') {
              window.location.href = '/admin';
            } else {
              window.location.href = '/dashboard';
            }
          } else {
            errorDiv.textContent = data.message || 'Invalid email or password';
            errorDiv.classList.remove('hidden');
          }
        } catch (err) {
          errorDiv.textContent = 'An error occurred. Please try again.';
          errorDiv.classList.remove('hidden');
        } finally {
          btnText.textContent = 'Sign In';
          spinner.classList.add('hidden');
        }
      });

      // Register form - CLIENT ONLY
      document.getElementById('registerForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('registerName').value;
        const email = document.getElementById('registerEmail').value;
        const phone = document.getElementById('registerPhone').value;
        const address = document.getElementById('registerAddress').value;
        const password = document.getElementById('registerPassword').value;
        const passwordConfirm = document.getElementById('registerPasswordConfirm').value;
        const errorDiv = document.getElementById('registerError');
        const successDiv = document.getElementById('registerSuccess');
        const btnText = document.getElementById('registerBtnText');
        const spinner = document.getElementById('registerSpinner');

        errorDiv.classList.add('hidden');
        successDiv.classList.add('hidden');

        if (password !== passwordConfirm) {
          errorDiv.textContent = 'Passwords do not match';
          errorDiv.classList.remove('hidden');
          return;
        }

        if (password.length < 8) {
          errorDiv.textContent = 'Password must be at least 8 characters';
          errorDiv.classList.remove('hidden');
          return;
        }

        btnText.textContent = 'Creating account...';
        spinner.classList.remove('hidden');

        try {
          const res = await fetch('/api/users/register-client', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, phone, address, password, passwordConfirm }),
          });
          const data = await res.json();

          if (data.status === 'success') {
            successDiv.textContent = 'Account created successfully! You can now sign in.';
            successDiv.classList.remove('hidden');
            document.getElementById('registerForm').reset();
            setTimeout(() => { loginTab.click(); }, 2000);
          } else {
            errorDiv.textContent = data.message || 'Registration failed';
            errorDiv.classList.remove('hidden');
          }
        } catch (err) {
          errorDiv.textContent = 'An error occurred. Please try again.';
          errorDiv.classList.remove('hidden');
        } finally {
          btnText.textContent = 'Create Account';
          spinner.classList.add('hidden');
        }
      });
