extends layout

block content
  .max-w-4xl.mx-auto
    //- Actions Bar
    .flex.items-center.justify-between.mb-6
      a.btn.btn-secondary(href="/dashboard")
        svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
        span Back to Dashboard
      .flex.gap-3.no-print
        a.btn.btn-secondary(href="/print-ready" target="_blank")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
          span Print View
        button.btn.btn-secondary(onclick="downloadPDF('birth')")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
          span Download PDF
        button.btn.btn-primary(onclick="window.print()")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
          span Print

    //- Certificate
    .card.p-8.bg-white.text-dark-900
      //- Header
      .text-center.border-b-2.border-dark-200.pb-6.mb-6
        .flex.items-center.justify-center.gap-4.mb-4
          img.w-16.h-16(src="/images/stamp1.png" alt="Seal")
          div
            h1.text-2xl.font-bold.text-dark-900 REPUBLIC OF CAMEROON
            p.text-sm.text-dark-600 Peace - Work - Fatherland
          img.w-16.h-16(src="/images/stamp2.png" alt="Seal")
        h2.text-xl.font-bold.text-primary-700.mt-4 BIRTH CERTIFICATE
        if birth && birth.certificateNumber
          p.text-sm.text-dark-500.mt-2 Certificate No: #{birth.certificateNumber}

      if birth
        //- Child Information
        .mb-6
          h3.text-lg.font-semibold.text-primary-700.mb-4.flex.items-center.gap-2
            svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
            span Child Information
          .grid.gap-4(class="md:grid-cols-2")
            .p-3.bg-dark-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Full Name
              p.font-semibold= birth.givenname + ' ' + birth.surname
            .p-3.bg-dark-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Date of Birth
              p.font-semibold= birth.bornOn ? new Date(birth.bornOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .p-3.bg-dark-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Place of Birth
              p.font-semibold= birth.bornAt
            .p-3.bg-dark-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Sex
              p.font-semibold.capitalize= birth.sex

        //- Father Information
        .mb-6
          h3.text-lg.font-semibold.text-blue-700.mb-4.flex.items-center.gap-2
            svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
            span Father's Information
          .grid.gap-4(class="md:grid-cols-2")
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Full Name
              p.font-semibold= birth.fatherName
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Date of Birth
              p.font-semibold= birth.fatherBornOn ? new Date(birth.fatherBornOn).toLocaleDateString() : '-'
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Place of Birth
              p.font-semibold= birth.fatherBornAt
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Residence
              p.font-semibold= birth.fatherResidentAt
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Occupation
              p.font-semibold= birth.fatherOccupation
            .p-3.bg-blue-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Nationality
              p.font-semibold= birth.fatherNationality
            .p-3.bg-blue-50.rounded-lg(class="md:col-span-2")
              p.text-xs.text-dark-500.uppercase National ID
              p.font-semibold= birth.fatherRefDoc

        //- Mother Information
        .mb-6
          h3.text-lg.font-semibold.text-pink-700.mb-4.flex.items-center.gap-2
            svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
            span Mother's Information
          .grid.gap-4(class="md:grid-cols-2")
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Full Name
              p.font-semibold= birth.motherName
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Date of Birth
              p.font-semibold= birth.motherBornOn ? new Date(birth.motherBornOn).toLocaleDateString() : '-'
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Place of Birth
              p.font-semibold= birth.motherBornAt
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Residence
              p.font-semibold= birth.motherResidentAt
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Occupation
              p.font-semibold= birth.motherOccupation || 'N/A'
            .p-3.bg-pink-50.rounded-lg
              p.text-xs.text-dark-500.uppercase Nationality
              p.font-semibold= birth.motherNationality
            .p-3.bg-pink-50.rounded-lg(class="md:col-span-2")
              p.text-xs.text-dark-500.uppercase National ID
              p.font-semibold= birth.motherRefDoc

        //- Footer
        .border-t-2.border-dark-200.pt-6.mt-6
          .grid.gap-6(class="md:grid-cols-2")
            div
              p.text-xs.text-dark-500.uppercase Drawn Up On
              p.font-semibold= birth.drawnUpOn ? new Date(birth.drawnUpOn).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .text-right
              p.text-xs.text-dark-500.uppercase.mb-8 Registrar's Signature
              .border-t.border-dark-300.pt-2
                p.text-sm.text-dark-600 Civil Registry Officer

      else
        .text-center.py-12
          p.text-dark-500 No birth certificate data available
