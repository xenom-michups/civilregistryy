doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Marriage Certificate - Print
    style.
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Times New Roman', serif; padding: 40px; background: white; color: #1a1a1a; }
      .certificate { max-width: 900px; margin: 0 auto; border: 3px double #be185d; padding: 40px; }
      .header { text-align: center; border-bottom: 2px solid #be185d; padding-bottom: 20px; margin-bottom: 20px; }
      .header h1 { font-size: 24px; font-weight: bold; margin-bottom: 5px; }
      .header h2 { font-size: 20px; color: #be185d; margin-top: 15px; }
      .header p { font-size: 12px; color: #666; }
      .seals { display: flex; justify-content: center; gap: 20px; margin-bottom: 15px; }
      .seals img { width: 60px; height: 60px; }
      .couple { text-align: center; padding: 20px; background: linear-gradient(to right, #eff6ff, #fdf2f8, #eff6ff); margin-bottom: 25px; }
      .couple-names { display: flex; justify-content: center; align-items: center; gap: 20px; }
      .couple-name { font-size: 22px; font-weight: bold; }
      .couple-name.groom { color: #1d4ed8; }
      .couple-name.bride { color: #be185d; }
      .heart { font-size: 24px; color: #be185d; }
      .columns { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
      .section { margin-bottom: 20px; }
      .section-title { font-size: 14px; font-weight: bold; margin-bottom: 10px; border-bottom: 1px solid #ddd; padding-bottom: 5px; }
      .section-title.groom { color: #1d4ed8; }
      .section-title.bride { color: #be185d; }
      .field { margin-bottom: 8px; }
      .field-label { font-size: 10px; color: #666; text-transform: uppercase; }
      .field-value { font-size: 13px; font-weight: 500; }
      .marriage-details { background: #f0fdf4; padding: 15px; margin-top: 20px; }
      .marriage-details .section-title { color: #166534; }
      .details-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }
      .footer { border-top: 2px solid #be185d; padding-top: 20px; margin-top: 30px; display: flex; justify-content: space-between; }
      .signature { text-align: right; }
      .signature-line { border-top: 1px solid #333; width: 200px; margin-top: 50px; padding-top: 5px; }
      @media print { body { padding: 0; } .certificate { border: none; } }

  body
    .certificate
      .header
        .seals
          img(src="/images/stamp1.png" alt="Seal")
          img(src="/images/stamp2.png" alt="Seal")
        h1 REPUBLIC OF CAMEROON
        p Peace - Work - Fatherland
        h2 MARRIAGE CERTIFICATE
        if marriage && (marriage.certificateNumber || marriage.certificate_number)
          p Certificate No: #{marriage.certificateNumber || marriage.certificate_number}

      if marriage
        .couple
          .couple-names
            .couple-name.groom= (marriage.groomGivenName || marriage.groom_given_name) + ' ' + (marriage.groomSurname || marriage.groom_surname)
            .heart ❤
            .couple-name.bride= (marriage.brideGivenName || marriage.bride_given_name) + ' ' + (marriage.brideSurname || marriage.bride_surname)

        .columns
          .column
            .section
              .section-title.groom Groom's Information
              .field
                .field-label Date of Birth
                .field-value= (marriage.groomBornOn || marriage.groom_born_on) ? new Date(marriage.groomBornOn || marriage.groom_born_on).toLocaleDateString() : '-'
              .field
                .field-label Place of Birth
                .field-value= marriage.groomPlaceBirth || marriage.groom_place_birth
              .field
                .field-label Residence
                .field-value= marriage.groomResidentAt || marriage.groom_resident_at
              .field
                .field-label Profession
                .field-value= marriage.groomProfession || marriage.groom_profession
              .field
                .field-label Nationality
                .field-value= marriage.groomNationality || marriage.groom_nationality
              .field
                .field-label National ID
                .field-value= marriage.groomIdNum || marriage.groom_id_num
              .field
                .field-label Father's Name
                .field-value= marriage.groomFatherName || marriage.groom_father_name
              .field
                .field-label Mother's Name
                .field-value= marriage.groomMotherName || marriage.groom_mother_name
              .field
                .field-label Witness
                .field-value= marriage.groomWitnessName || marriage.groom_witness_name

          .column
            .section
              .section-title.bride Bride's Information
              .field
                .field-label Date of Birth
                .field-value= (marriage.brideBornOn || marriage.bride_born_on) ? new Date(marriage.brideBornOn || marriage.bride_born_on).toLocaleDateString() : '-'
              .field
                .field-label Place of Birth
                .field-value= marriage.bridePlaceBirth || marriage.bride_place_birth
              .field
                .field-label Residence
                .field-value= marriage.brideResidentAt || marriage.bride_resident_at
              .field
                .field-label Profession
                .field-value= marriage.brideProfession || marriage.bride_profession
              .field
                .field-label Nationality
                .field-value= marriage.brideNationality || marriage.bride_nationality
              .field
                .field-label National ID
                .field-value= marriage.brideIdNum || marriage.bride_id_num
              .field
                .field-label Father's Name
                .field-value= marriage.brideFatherName || marriage.bride_father_name
              .field
                .field-label Mother's Name
                .field-value= marriage.brideMotherName || marriage.bride_mother_name
              .field
                .field-label Witness
                .field-value= marriage.brideWitnessName || marriage.bride_witness_name

        .marriage-details
          .section-title Marriage Details
          .details-grid
            .field
              .field-label Matrimonial Regime
              .field-value= marriage.matrimonialRegime || marriage.matrimonial_regime
            .field
              .field-label Marriage Type
              .field-value= marriage.marriageType || marriage.marriage_type
            .field
              .field-label Objections
              .field-value= marriage.objections

        .footer
          .field
            .field-label Drawn Up On
            .field-value= (marriage.drawnUpOn || marriage.drawn_up_on) ? new Date(marriage.drawnUpOn || marriage.drawn_up_on).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
          .signature
            .signature-line Civil Registry Officer
