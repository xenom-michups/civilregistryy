extends layout

block content
  .max-w-4xl.mx-auto
    //- Actions Bar
    .flex.items-center.justify-between.mb-6
      a.btn.btn-secondary(href="/dashboard")
        svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
        span Back to Dashboard
      .flex.gap-3.no-print
        a.btn.btn-secondary(href="/print-ready-marriage" target="_blank")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
          span Print View
        button.btn.btn-secondary(onclick="downloadPDF('marriage')")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
          span Download PDF
        button.btn.btn-primary(onclick="window.print()")
          svg.w-5.h-5.mr-2(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
          span Print

    //- Certificate
    .card.p-8.bg-white.text-dark-900
      //- Header
      .text-center.border-b-2.border-dark-200.pb-6.mb-6
        .flex.items-center.justify-center.gap-4.mb-4
          img.w-16.h-16(src="/images/stamp1.png" alt="Seal")
          div
            h1.text-2xl.font-bold.text-dark-900 REPUBLIC OF CAMEROON
            p.text-sm.text-dark-600 Peace - Work - Fatherland
          img.w-16.h-16(src="/images/stamp2.png" alt="Seal")
        h2.text-xl.font-bold.text-pink-700.mt-4 MARRIAGE CERTIFICATE
        if marriage && marriage.certificateNumber
          p.text-sm.text-dark-500.mt-2 Certificate No: #{marriage.certificateNumber}

      if marriage
        //- Couple Names
        .text-center.mb-8.py-6.bg-gradient-to-r.from-blue-50.via-pink-50.to-blue-50.rounded-xl
          .flex.items-center.justify-center.gap-4
            .text-right
              p.text-2xl.font-bold.text-blue-700= (marriage.groomGivenName || marriage.groom_given_name) + ' ' + (marriage.groomSurname || marriage.groom_surname)
              p.text-sm.text-dark-500 Groom
            svg.w-8.h-8.text-pink-500(fill="currentColor" viewBox="0 0 24 24")
              path(d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
            .text-left
              p.text-2xl.font-bold.text-pink-700= (marriage.brideGivenName || marriage.bride_given_name) + ' ' + (marriage.brideSurname || marriage.bride_surname)
              p.text-sm.text-dark-500 Bride

        .grid.gap-8(class="md:grid-cols-2")
          //- Groom Information
          div
            h3.text-lg.font-semibold.text-blue-700.mb-4.flex.items-center.gap-2
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
              span Groom's Details
            .space-y-3
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Date of Birth
                p.font-semibold= (marriage.groomBornOn || marriage.groom_born_on) ? new Date(marriage.groomBornOn || marriage.groom_born_on).toLocaleDateString() : '-'
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Place of Birth
                p.font-semibold= marriage.groomPlaceBirth || marriage.groom_place_birth
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Residence
                p.font-semibold= marriage.groomResidentAt || marriage.groom_resident_at
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Profession
                p.font-semibold= marriage.groomProfession || marriage.groom_profession
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Nationality
                p.font-semibold= marriage.groomNationality || marriage.groom_nationality
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase National ID
                p.font-semibold= marriage.groomIdNum || marriage.groom_id_num
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Father's Name
                p.font-semibold= marriage.groomFatherName || marriage.groom_father_name
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Mother's Name
                p.font-semibold= marriage.groomMotherName || marriage.groom_mother_name
              .p-3.bg-blue-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Witness
                p.font-semibold= marriage.groomWitnessName || marriage.groom_witness_name

          //- Bride Information
          div
            h3.text-lg.font-semibold.text-pink-700.mb-4.flex.items-center.gap-2
              svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
              span Bride's Details
            .space-y-3
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Date of Birth
                p.font-semibold= (marriage.brideBornOn || marriage.bride_born_on) ? new Date(marriage.brideBornOn || marriage.bride_born_on).toLocaleDateString() : '-'
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Place of Birth
                p.font-semibold= marriage.bridePlaceBirth || marriage.bride_place_birth
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Residence
                p.font-semibold= marriage.brideResidentAt || marriage.bride_resident_at
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Profession
                p.font-semibold= marriage.brideProfession || marriage.bride_profession
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Nationality
                p.font-semibold= marriage.brideNationality || marriage.bride_nationality
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase National ID
                p.font-semibold= marriage.brideIdNum || marriage.bride_id_num
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Father's Name
                p.font-semibold= marriage.brideFatherName || marriage.bride_father_name
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Mother's Name
                p.font-semibold= marriage.brideMotherName || marriage.bride_mother_name
              .p-3.bg-pink-50.rounded-lg
                p.text-xs.text-dark-500.uppercase Witness
                p.font-semibold= marriage.brideWitnessName || marriage.bride_witness_name

        //- Marriage Details
        .mt-8.p-6.bg-primary-50.rounded-xl
          h3.text-lg.font-semibold.text-primary-700.mb-4 Marriage Details
          .grid.gap-4(class="md:grid-cols-3")
            .p-3.bg-white.rounded-lg
              p.text-xs.text-dark-500.uppercase Matrimonial Regime
              p.font-semibold= marriage.matrimonialRegime || marriage.matrimonial_regime
            .p-3.bg-white.rounded-lg
              p.text-xs.text-dark-500.uppercase Marriage Type
              p.font-semibold= marriage.marriageType || marriage.marriage_type
            .p-3.bg-white.rounded-lg
              p.text-xs.text-dark-500.uppercase Objections
              p.font-semibold= marriage.objections

        //- Footer
        .border-t-2.border-dark-200.pt-6.mt-8
          .grid.gap-6(class="md:grid-cols-2")
            div
              p.text-xs.text-dark-500.uppercase Drawn Up On
              p.font-semibold= (marriage.drawnUpOn || marriage.drawn_up_on) ? new Date(marriage.drawnUpOn || marriage.drawn_up_on).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .text-right
              p.text-xs.text-dark-500.uppercase.mb-8 Registrar's Signature
              .border-t.border-dark-300.pt-2
                p.text-sm.text-dark-600 Civil Registry Officer

      else
        .text-center.py-12
          p.text-dark-500 No marriage certificate data available
