{
  "name": "civil-registry",
  "version": "2.0.0",
  "private": true,
  "description": "Modern Civil Status Registry System",
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/styles/tailwind.css --watch",
    "build:css:prod": "npx tailwindcss -i ./src/input.css -o ./public/styles/tailwind.css --minify"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "pug": "^3.0.2",
    "puppeteer": "^24.43.1",
    "sequelize": "^6.35.2",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.0"
  },
  "author": "Civil Registry Team",
  "license": "MIT"
}
